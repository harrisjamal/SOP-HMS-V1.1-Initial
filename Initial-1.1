                            //Functionalities of Student Management Modules Starts from here;
class Student{
    private:
    string firstName;
    string lastName;
    string gender;
    int ID;
    bool roomDesginated;
    int studentCount;
public:
                                //Student Details Input For Addition Module;
    Student();
    void setStudentDetails();
    string getfirstname();
    string getlastname();
    string getgender();
    int getID();
    void showEnteredDetails();


};
Student::Student() {
    firstName = "";
    lastName = "";
    gender = "";
    ID = 0;
    roomDesginated = false;
    studentCount = 0;
}
void Student::setStudentDetails() {
    string fName, lName, gnD;
    int id;
    cout << "Enter your First Name: ";
    cin >> fName;
    cout << "Enter your Last Name: ";
    cin >> lName;
    cout << "Enter your Gender: ";
    cin >> gnD;
    cout << "Enter your ID: ";
    cin >> id;
    firstName = fName;
    lastName = lName;
    gender = gnD;
    ID = id;
    showEnteredDetails();
}
string Student::getfirstname() {
    return firstName;
}
string Student::getlastname() {
    return lastName;
}
string Student::getgender() {
    return gender;
}
int Student::getID() {
    return ID;
}
void Student::showEnteredDetails() {
    string ans1, ans2;
    start1:
    cout << "Name: " << firstName << " " << lastName<< endl;
    cout << "Gender: " << gender << endl;
    cout << "ID: " << ID << endl;
    cout << "Do you want to assign student " << firstName << " " << lastName << " " << ID << " " << "a room?" << endl;
    cin >> ans1;
    if (ans1 == "Yes" || ans1 == "yes" || ans1 == "YES") {
        roomDesginated = true;
        cout << "--------------Room Assigned Successfully!--------------" << endl;
        studentCount++;

    }
    else {
        cout << "--------------Room Not Assigned!--------------" << endl;
    }
    cout << "Do you want an another Student: " << endl;
    cin >> ans2;
    if (ans2 == "Yes" || ans2 == "yes" || ans2 == "YES") {
        goto start1;
    }
    else {
        cout << "--------------Student Addition Mode Closed Successfully!--------------" << endl;
    }

}


